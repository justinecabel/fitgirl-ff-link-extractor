#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Remove the obsolete app-owned profile when upgrading from 0.2.0.
    profile=/etc/apparmor.d/fitgirl-ff-link-extractor-browser
    if [ -f "$profile" ]; then
        if command -v apparmor_parser >/dev/null 2>&1; then
            apparmor_parser --remove "$profile" || true
        fi
        rm -f "$profile"
    fi
fi
