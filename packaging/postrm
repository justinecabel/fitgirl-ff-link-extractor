#!/bin/sh
set -e
case "$1" in
    remove|purge)
        profile=/etc/apparmor.d/fitgirl-ff-link-extractor-browser
        if [ -f "$profile" ]; then
            if command -v apparmor_parser >/dev/null 2>&1; then
                apparmor_parser --remove "$profile" || true
            fi
            rm -f "$profile"
        fi
        ;;
esac
